# performance related
input_delay 0
wayland_enable_ime no


copy_on_select yes

mouse_hide_wait     -3.0
cursor_shape          beam
cursor_blink_interval 0
#cursor_trail        300
#cursor_trail_decay 0.1 0.4
#cursor_trail_start_threshold 2
#
inactive_text_alpha 0.5
window_border_width 0.5pt

font_size 14.0
adjust_line_height 110%

enable_audio_bell no
macos_option_as_alt yes
hide_window_decorations no
#macos_titlebar_color background
macos_show_window_title_in window

remember_window_size yes

shell_integration enabled
strip_trailing_spaces smart

scrollback_lines 10000

allow_hyperlinks yes
detect_urls yes

confirm_os_window_close 0

startup_session none

kitty_mod cmd

map ctrl+z close_window
map cmd+shift+r load_config_file

map alt+backspace send_text all \x1b\x7f 
map cmd+backspace send_text all \x15

window_padding_width 20
enabled_layouts splits
map cmd+r launch --location=vsplit --cwd=current
map cmd+enter launch --location=vsplit --cwd=current
map cmd+u launch --location=hsplit --cwd=current

map cmd+h neighboring_window left
map cmd+j neighboring_window down
map cmd+k neighboring_window up
map cmd+l neighboring_window right

map cmd+n next_window
map cmd+p previous_window

map page_up scroll_page_up
map page_down scroll_page_down

shell /bin/zsh


# allow other programs to control kitty
allow_remote_control yes
listen_on unix:/tmp/mykitty



# BEGIN_KITTY_FONTS
font_family      family="IosevkaTerm Nerd Font Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS


# BEGIN_KITTY_THEME
# Dark Pastel
include current-theme.conf
# END_KITTY_THEME
